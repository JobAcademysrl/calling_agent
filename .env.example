# Indirizzo pubblico del server, senza barra finale (es. https://agente-vocale.up.railway.app)
PUBLIC_URL=

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Modello: claude-opus-5-5 (predefinito) oppure claude-haiku-5-5, più economico e veloce
ANTHROPIC_MODEL=claude-opus-5-5

# ElevenLabs: trascrizione e voce con la stessa chiave (elevenlabs.io → Developers → API Keys)
ELEVENLABS_API_KEY=
# Id di una voce multilingue dalla Voice Library di ElevenLabs
ELEVENLABS_VOICE_ID=

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Il numero italiano acquistato su Twilio, formato +39...
TWILIO_NUMERO=

# Supabase della piattaforma MIA (Project Settings → API → service_role). Resta solo sul server.
SUPABASE_URL=https://mleimczuxvwhtaqqkhtx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Notion: integrazione interna collegata al database "Pratiche microcredito"
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=db50ab19-40b2-4eba-be4c-e099454ec755

# Segreto per avviare i richiami (POST /richiama) e per il webhook di Supabase
RICHIAMA_SEGRETO=
# 1 = richiama in automatico chi compila il modulo (dentro la fascia oraria)
RICHIAMO_AUTOMATICO=0
